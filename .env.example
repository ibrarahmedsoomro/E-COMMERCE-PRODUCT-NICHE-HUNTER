# Database Configuration (Defaults to SQLite in data/hunter.db if omitted)
# DATABASE_URL=postgresql://user:password@localhost:5432/hunter_db

# Gemini API Key (Optional: system runs with zero-cost Mock LLM when omitted)
GEMINI_API_KEY=your_gemini_api_key_here

# Marketplace Data Provider API Keys (Optional)
KEEPA_API_KEY=your_keepa_api_key_here
RAINFOREST_API_KEY=your_rainforest_api_key_here
